          }
        },
        {
          "name": "Get Complete Audit Trail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}/audit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "{{paymentId}}", "audit"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Validation Rules",
      "item": [
        {
          "name": "Create Validation Rule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Custom Amount Limit\",\n  \"description\": \"Limit payments to 5000 USD\",\n  \"ruleType\": \"AMOUNT_RANGE\",\n  \"ruleDefinition\": {\"maxAmount\": 5000, \"minAmount\": 10},\n  \"severity\": \"HARD\",\n  \"orderOfExecution\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/validation-rules",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "validation-rules"]
            }
          }
        },
        {
          "name": "List All Rules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/validation-rules",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "validation-rules"]
            }
          }
        },
        {
          "name": "Get Rule Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/validation-rules/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "validation-rules", "1"]
            }
          }
        },
        {
          "name": "Update Rule",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Rule Name\",\n  \"description\": \"Updated description\",\n  \"ruleType\": \"AMOUNT_RANGE\",\n  \"ruleDefinition\": {\"maxAmount\": 10000},\n  \"severity\": \"SOFT\",\n  \"orderOfExecution\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/validation-rules/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "validation-rules", "1"]
            }
          }
        },
        {
          "name": "Toggle Rule Active/Inactive",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/validation-rules/1/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "validation-rules", "1", "toggle"]
            }
          }
        },
        {
          "name": "Test Rule (Dry Run)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"test-payment-001\",\n  \"sourceAccount\": \"123456789012\",\n  \"destinationAccount\": \"210987654321\",\n  \"amount\": 5000.00,\n  \"currency\": \"USD\",\n  \"status\": \"CREATED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/validation-rules/1/test-dry-run",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "validation-rules", "1", "test-dry-run"]
            }
          }
        }
      ]
    },
