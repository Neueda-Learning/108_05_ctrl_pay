# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env and update values as needed
# DO NOT commit .env to version control (add to .gitignore)

# ============================================
# Docker Compose Settings
# ============================================

# Spring profile to activate (dev, docker, prod)
SPRING_PROFILES_ACTIVE=docker

# ============================================
# MySQL Configuration
# ============================================

# Root password for MySQL
MYSQL_ROOT_PASSWORD=admin123

# Database name to create
MYSQL_DATABASE=ctrl_pay

# ============================================
# Spring Boot Configuration
# ============================================

# Database connection username
SPRING_DATASOURCE_USERNAME=root

# Database connection password
SPRING_DATASOURCE_PASSWORD=admin123

# ============================================
# Java JVM Options
# ============================================

# Memory allocation for JVM
# -Xmx = max heap size, -Xms = initial heap size
JAVA_OPTS=-Xmx512m -Xms256m

# ============================================
# Timezone Configuration
# ============================================

# Timezone for application and database
TZ=UTC

# ============================================
# Port Mappings (if needed)
# ============================================

# MySQL exposed port (default: 3306)
# MYSQL_PORT=3306

# Spring Boot exposed port (default: 8080)
# APP_PORT=8080

